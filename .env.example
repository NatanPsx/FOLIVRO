# =====================================================================
# FOLIVRO - Configuração da Loja e Gateways de Pagamento
# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# NUNCA versione o arquivo ".env" com credenciais reais.
# =====================================================================

# URL base pública da aplicação (usada como notification_url no Mercado Pago;
# em testes locais com webhook, informe sua URL HTTPS do ngrok, ex.: https://abc123.ngrok-free.app/FOLIVRO-v6)
APP_URL=http://localhost/FOLIVRO-v6

# Modo de pagamento da loja:
#   simulated -> Gateway simulado (Pix/cartão fictícios para TCC/demonstração, sem dinheiro real)
#   real      -> Mercado Pago (Pix + Cartão tokenizado no navegador)
PAYMENT_MODE=simulated

# Comissão da plataforma sobre cada venda paga (ex.: 10 = 10%)
PLATFORM_FEE_PERCENT=10

# ---------------------------------------------------------------------
# MERCADO PAGO (use credenciais de TESTE / SANDBOX por padrão)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# ---------------------------------------------------------------------
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=troque-este-segredo-pelo-secret-do-webhook-mercadopago
MP_PIX_EXPIRATION_MIN=30
MP_ALLOW_PRODUCTION=false

# ---------------------------------------------------------------------
# GATEWAY SIMULADO (usado quando PAYMENT_MODE=simulated)
# ---------------------------------------------------------------------
SIMULATED_WEBHOOK_SECRET=segredo-webhook-simulado-folivro-dev
SIMULATED_PIX_EXPIRATION_MIN=15
SIMULATED_PIX_SHORT_EXPIRATION_SEC=60
